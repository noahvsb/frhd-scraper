{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./lib/*"]
    },
    "strict": true,
    "types": ["node", "bun-types"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
  },
  "include": ["**/*.ts"],
}